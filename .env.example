# Copy to .env and fill in. Never commit the real .env file.

# --- Database ---
DB_PASSWORD=change-me

# --- Security ---
# At least 32 random characters, e.g.:  openssl rand -base64 48
JWT_SECRET=

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- First administrator (created on startup if both are set) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Optional ---
# Insert sample articles when the database is empty
SEED_DEMO_DATA=true
# Public URL of the API, used for uploaded image links
PUBLIC_BASE_URL=http://localhost:8080
